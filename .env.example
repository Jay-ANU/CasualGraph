# Root ESG pipeline configuration. Migration guide: docs/DEEPSEEK_V4_PRO_UPGRADE.md

# Deployment safety
# Production/staging refuses to start without a strong, non-default JWT secret.
APP_ENV=development
JWT_SECRET=
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=https://.*\.ngrok-free\.app|https://.*\.ngrok\.app

# Base model and adapter (optional local extraction)
ESG_BASE_MODEL_PATH=
ESG_ADAPTER_PATH=
HF_LOCAL_FILES_ONLY=true
ESG_MODEL_ALLOW_DOWNLOAD=false

# Ingestion performance tuning
CHUNK_SIZE=1500
CHUNK_OVERLAP=150
EXTRACTION_CACHE_ENABLED=true
EXTRACTION_CACHE_PATH=./data/extraction_cache.sqlite
# Keep 1 for local QLoRA; increase only when your remote rate limit allows it.
EXTRACTION_MAX_WORKERS=10
INGESTION_JOB_MAX_WORKERS=4
INGESTION_MAX_QUEUED_JOBS=16
INGESTION_AUDIT_THROTTLE_SECONDS=2.0

# Embeddings are independent of the chat model. bge-m3 needs a 1024-d index.
ESG_EMBEDDING_MODEL_PATH=
ESG_EMBEDDING_LOCAL_FILES_ONLY=false
ESG_EMBEDDING_ALLOW_DOWNLOAD=false

# Single text-generation provider: both Flash and Deep use DeepSeek V4 Pro.
# Fill the key only in a local .env or the backend's secret store, never in Git.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_MAX_RETRIES=1
# Optional custom proxy Messages endpoint; default is base root + /anthropic.
DEEPSEEK_ANTHROPIC_BASE_URL=
OPENAI_TEMPERATURE=0.1
# Legacy per-task OPENAI_MODEL / RAG_*_MODEL values are no longer needed.
# 'openai' remains a valid RAG_ANSWER_MODE format selector, not a provider.
RAG_ANSWER_MODE=auto
RAG_ALLOW_SPECULATION=false
RAG_MIN_SOURCE_RELEVANCE=0.35
RAG_MULTI_QUERY_ENABLED=false
RAG_MULTI_QUERY_N=3
RAG_HYBRID_ENABLED=false
RAG_HYBRID_BM25_WEIGHT=0.4
RAG_HYBRID_FUSION=rrf
RAG_RRF_K=60
RAG_RRF_VECTOR_WEIGHT=1.0
RAG_RRF_BM25_WEIGHT=1.0
RAG_RRF_TERM_BOOST=0.01
RAG_RRF_DIVERSITY_PENALTY=0.0
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K_BEFORE=20
RERANKER_TOP_K_AFTER=5
HYDE_ENABLED=false
HYDE_MAX_TOKENS=200
HYDE_MIN_CHARS=50
RAG_DECOMPOSE_ENABLED=false
RAG_DECOMPOSE_MAX_SUBQ=3
RAG_ROUTER_ENABLED=true
RAG_ROUTER_LLM_ENABLED=false
RAG_CHITCHAT_ENABLED=true
RAG_ANSWER_INTENT_ROUTER_ENABLED=true
RAG_RATE_LIMIT_ENABLED=true
RAG_FREE_DAILY_POINTS=30
RAG_FLASH_POINT_COST=1
RAG_DEEP_POINT_COST=5
RAG_MIN_SECONDS_BETWEEN_REQUESTS=20
RAG_ANONYMOUS_ENABLED=false

# Deep uses the DeepSeek Anthropic-compatible API, not a Claude account.
RAG_DEEP_MAX_TOKENS=8192
RAG_DEEP_TEMPERATURE=0.2
RAG_DEEP_TIMEOUT=120

# Optional desktop vision is separate; V4 Pro text is NOT a vision replacement.
# Check the existing desktop vision setup separately before removing old secrets.
OPENAI_API_KEY=
DESKTOP_SCREENSHOT_SUMMARY_MODEL=gpt-4o-mini
DESKTOP_SCREENSHOT_SUMMARY_MAX_TOKENS=700
DESKTOP_SCREENSHOT_MAX_IMAGE_BYTES=6000000

# HITL notifications (opt-in)
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_DB_PATH=backend/notifications.db
NOTIFICATIONS_DEDUP_WINDOW_MINUTES=60
NOTIFICATIONS_DAILY_EMAIL_CAP=8
NOTIFICATIONS_SMTP_URL=
NOTIFICATIONS_ADMIN_EMAILS=

# MCP email: sending requires this switch, MAIL_ENABLED and the allowlist.
MCP_EMAIL_ENABLED=false
MCP_EMAIL_DRY_RUN=true
MCP_EMAIL_ALLOWED_RECIPIENTS=admin@example.com,@example.com
MCP_EMAIL_ALLOW_ALL=false
MCP_EMAIL_AUDIT_PATH=./data/mcp_email_audit.jsonl
MCP_EMAIL_MAX_BODY_CHARS=12000
MOCK_MODE=false

# Redis and full-graph view caching
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
KG_VIEW_CACHE_ENABLED=true
KG_VIEW_CACHE_TTL_SECONDS=1800
KG_VIEW_CACHE_STALE_SECONDS=86400
KG_VIEW_CACHE_LOCK_SECONDS=180
KG_VIEW_CACHE_WAIT_SECONDS=12
KG_VIEW_CACHE_MEMORY_MAX=128
KG_VIEW_DETAIL_RENDER_NODE_LIMIT=2000
KG_VIEW_REDIS_RETRY_SECONDS=15
KG_VIEW_LLM_CLUSTER_LABELS=true
KG_VIEW_CLUSTER_LABEL_MODEL=deepseek-v4-pro

TRACE_ENABLED=false
TRACE_PATH=./data/traces.jsonl

# Structured metric extraction adds a model call per chunk; opt in deliberately.
ESG_METRICS_EXTRACTION_ENABLED=false
ESG_METRICS_DB_PATH=./data/esg_metrics.sqlite
ESG_METRICS_TAXONOMY_PATH=./data/taxonomy/esg_metrics.yaml
ESG_METRICS_MIN_CONFIDENCE=0.5

# Remote extraction and routers inherit DEEPSEEK_MODEL.
DEEPSEEK_EXTRACTION_MAX_TOKENS=8000
DEEPSEEK_CACHE_ENABLED=true
DEEPSEEK_CACHE_TTL_SECONDS=1800
DEEPSEEK_FAILURE_CACHE_TTL_SECONDS=60
DEEPSEEK_CIRCUIT_FAILURE_THRESHOLD=3
DEEPSEEK_CIRCUIT_BREAK_SECONDS=60
RAG_ANSWER_INTENT_ROUTER_TIMEOUT=2
RAG_ANSWER_INTENT_ROUTER_MAX_TOKENS=240
RAG_HYBRID_AGENT_ROUTER_LLM_ENABLED=true
RAG_HYBRID_AGENT_ROUTER_TIMEOUT=3
RAG_HYBRID_AGENT_ROUTER_MAX_TOKENS=260
RAG_ROUTER_TIMEOUT=2
RAG_ROUTER_MAX_TOKENS=160

# Optional comma-separated admin allowlist for /admin.
ADMIN_EMAILS=

# Registration email verification: use an SMTP authorization code, not a password.
MAIL_ENABLED=false
MAIL_PROVIDER=qq
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_USER=your@qq.com
MAIL_SMTP_PASSWORD=your_qq_mail_authorization_code
MAIL_FROM=your@qq.com
MAIL_FROM_NAME=CausalGraph AI
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_LENGTH=6

VECTOR_STORE_PROVIDER=local
USER_MEMORY_VECTOR_ENABLED=true
USER_MEMORY_VECTOR_PROVIDER=local
USER_MEMORY_VECTOR_NAMESPACE=esg-demo-memory
USER_MEMORY_VECTOR_DIR=./data/vector_store/user_memories

PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=esg-demo
PINECONE_METRIC=cosine

# Use the connection URI and database name from your Neo4j instance.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=ESG
NEO4J_AUTO_SYNC=true
