APP_ENV=production
JWT_SECRET=

DATA_DIR=/data
AUTH_DB_PATH=/data/auth.db
CAUSALGRAPH_DB_PATH=/data/causalgraph.db
NOTIFICATIONS_DB_PATH=/data/notifications.db
ESG_METRICS_DB_PATH=/data/esg_metrics.sqlite
EXTRACTION_CACHE_PATH=/data/extraction_cache.sqlite
TRACE_PATH=/data/traces.jsonl

CORS_ALLOW_ORIGINS=https://casualgraphai.vercel.app,https://frontend-cyan-six-45.vercel.app
CORS_ALLOW_ORIGIN_REGEX=

# 'openai' is the legacy answer-format selector, not the billing provider.
RAG_ANSWER_MODE=openai
EMBEDDING_BACKEND=deepinfra
ESG_EXTRACTION_BACKEND=remote
INGESTION_ENABLED=true
INGESTION_JOB_MAX_WORKERS=1

# Text generation: both Flash and Deep use this DeepSeek profile.
# Do not put secrets in frontend variables or commit a populated .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_MAX_RETRIES=1
RAG_DEEP_MAX_TOKENS=8192
RAG_DEEP_TIMEOUT=120
DEEPINFRA_API_KEY=

VECTOR_STORE_PROVIDER=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=esg-demo

NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=ESG
NEO4J_AUTO_SYNC=true
