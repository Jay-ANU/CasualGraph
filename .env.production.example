APP_ENV=production
JWT_SECRET=

DATA_DIR=/data
AUTH_DB_PATH=/data/auth.db
CAUSALGRAPH_DB_PATH=/data/causalgraph.db
NOTIFICATIONS_DB_PATH=/data/notifications.db

CORS_ALLOW_ORIGINS=https://casualgraphai.vercel.app,https://frontend-cyan-six-45.vercel.app
CORS_ALLOW_ORIGIN_REGEX=

LLM_PROVIDER=deepseek
RAG_ANSWER_MODE=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
RAG_DEEP_MODEL=deepseek-v4-pro
CHAT_MAX_TOKENS=2048
RAG_DEEP_MAX_TOKENS=16384
RAG_DEEP_REASONING_EFFORT=high
RAG_DEEP_TIMEOUT=120
EMBEDDING_BACKEND=deepinfra
INGESTION_JOB_MAX_WORKERS=1

DEEPINFRA_API_KEY=
DEEPSEEK_API_KEY=

VECTOR_STORE_PROVIDER=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=esg-demo

NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=ESG
NEO4J_AUTO_SYNC=true
